<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Launch at login and restart after a crash.
  Embedded at Striple.app/Contents/Library/LaunchAgents/ and registered by the app with
  SMAppService.agent(plistName: "com.fskroes.Striple.agent.plist").
  BundleProgram is relative to the app bundle (supported only for SMAppService plists).
  KeepAlive/SuccessfulExit=false: launchd starts Striple again after a crash or a
  non-zero exit, but not after the user quits (exit status 0).
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.fskroes.Striple.agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/Striple</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.fskroes.Striple</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ThrottleInterval</key>
	<integer>5</integer>
</dict>
</plist>
