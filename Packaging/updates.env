# Public update settings. Every `make app` reads this file, so every build checks for updates.
# All values here are public. The private EdDSA key is in the login keychain of the Mac that
# publishes (Sparkle account below). See docs/RELEASING.md.
# SPOOL_UPDATES=off in the environment builds without updates.
# The releases repository is public and holds only the release files: Spool downloads its updates
# from it. The source repository is private; a release is built from a commit on its main.
SPOOL_RELEASES_REPO=fskroes/spool-releases
SPOOL_SOURCE_REPO=fskroes/Spool
SPOOL_FEED_URL=https://github.com/fskroes/spool-releases/releases/latest/download/appcast.xml
SPOOL_ED_PUBLIC_KEY=hAm3rDnXVAEA+HDMF9gtR3Phz847joC5FSPm0TS8Hp4=
# The keychain account of the private key keeps the old name of Spool, Striple: the key is stored there.
SPOOL_ED_KEY_ACCOUNT=com.fskroes.Striple
# The public key that checks the license keys (docs/LICENSE-KEYS.md). Public: it is in every copy of Spool.
# The owner makes the pair once with `spool-license keygen` and puts the public key here
# (docs/RELEASING.md, "License keys"). Empty: a bundled build has no key, so it asks for a license that it
# cannot accept, and `make publish` stops. Never use a key from docs/license-test-vectors.json.
SPOOL_LICENSE_PUBLIC_KEY=
# The Apple Team ID of the releases. Every release is signed with a "Developer ID Application" identity of
# this team and notarized by Apple. macOS ties the Accessibility permission of an installed copy to the team,
# not to one certificate: a renewed certificate of the same team keeps it.
SPOOL_TEAM_ID=98L4368F9K
# The name of the notarytool profile in the login keychain of the Mac that publishes. Only the name is here.
# Make it once with `xcrun notarytool store-credentials` (docs/RELEASING.md).
SPOOL_NOTARY_PROFILE=spool-notary
