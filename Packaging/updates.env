# Public update settings. Every `make app` reads this file, so every build checks for updates.
# All values here are public. The private EdDSA key is in the login keychain of the Mac that
# publishes (Sparkle account below). See docs/RELEASING.md.
# STRIPLE_UPDATES=off in the environment builds without updates.
STRIPLE_RELEASES_REPO=fskroes/striple-releases
STRIPLE_FEED_URL=https://github.com/fskroes/striple-releases/releases/latest/download/appcast.xml
STRIPLE_ED_PUBLIC_KEY=hAm3rDnXVAEA+HDMF9gtR3Phz847joC5FSPm0TS8Hp4=
STRIPLE_ED_KEY_ACCOUNT=com.fskroes.Striple
# SHA-1 of the "Striple Local Signing" certificate. Every release must be signed with it: the
# Accessibility permission of an installed copy is tied to it. Back it up (docs/RELEASING.md).
STRIPLE_SIGNING_CERT_SHA1=B608FA4F3D9A1FC14CDBAB47421A660E429053DC
